# Copy to .env and fill in locally. Never commit .env.
# All settings are optional at this stage.

# S3-compatible storage (documents): AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO, ...
# Endpoint URL of the service; leave empty for AWS S3
S3_ENDPOINT_URL=
# Region, e.g. us-east-1 (R2 uses "auto")
S3_REGION=
S3_BUCKET=
# Optional folder inside the bucket, e.g. docs/
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for services that need bucket-in-path URLs (often self-hosted, e.g. MinIO)
S3_FORCE_PATH_STYLE=false

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# SearXNG web search
SEARXNG_BASE_URL=

# LLM provider
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Embedding provider: "fake" (default; tests/offline only, does not understand meaning)
# or "fastembed" (real model running locally; downloaded on first use, then cached)
EMBEDDING_PROVIDER=fake
# Model name for fastembed (ignored by "fake"); default BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Local Postgres + pgvector database (docker-compose.yml). Dev values only;
# if you change these, change DATABASE_URL to match.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
