# Copy to .env and fill in locally. Never commit .env.
# All settings are optional at this stage.

# S3-compatible storage (documents): AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO, ...
# Endpoint URL of the service; leave empty for AWS S3
S3_ENDPOINT_URL=
# Region, e.g. us-east-1 (R2 uses "auto")
S3_REGION=
S3_BUCKET=
# Optional folder inside the bucket, e.g. docs/
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for services that need bucket-in-path URLs (often self-hosted, e.g. MinIO)
S3_FORCE_PATH_STYLE=false

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# SearXNG web search
SEARXNG_BASE_URL=

# LLM provider
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Embedding provider
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
